# Git LFS - Large File Storage
public/videos/*.mp4 filter=lfs diff=lfs merge=lfs -text

# Security: Prevent .env files from being tracked
# Even if .gitignore fails, these files will not be diffed/merged
.env* -diff -merge
.env.local -diff -merge
.env.*.local -diff -merge

# Treat binary files appropriately
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.pdf binary
